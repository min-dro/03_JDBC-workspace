<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE properties SYSTEM "http://java.sun.com/dtd/properties.dtd">
<properties>

	<!-- xml 파일의 주석 형식 -->
	
	<!-- 신상품 조회용 쿼리문 -->
	<entry key="selectNewMouse">
		SELECT *
		  FROM MOUSE
		  WHERE RELEASE_DATE >= ADD_MONTHS(SYSDATE, -6)
		 ORDER BY MOUSE_NO ASC
	</entry>
	
	
	<!-- 전체 상품 조회용 쿼리문 -->
	<entry key="selectAll">
		SELECT *
		  FROM MOUSE
		 ORDER BY MOUSE_NO ASC
	</entry>
	
	<!-- 키워드로 검색용 쿼리문 -->
	<entry key="selectByKeyword">
        SELECT *
	      FROM MOUSE
		 WHERE NAME LIKE ?
    </entry>
		
	<!-- 물품 등록용 쿼리문 (? 8개) -->
	<entry key="insertMouse">
		INSERT INTO MOUSE VALUES(SEQ_MOUSE_NO.NEXTVAL
								, ?
								, ?
								, ?
								, ?
								, ?
								, ?
								, ?
								, ?)
	</entry>
		
	<!-- 물품 정보용 변경 쿼리문 -->
	<entry key="updateMouse">
		UPDATE MOUSE
	       SET BRAND = ?,
		       STOCK = ?,
		       PRICE = ?,
		       CONNECT_TYPE = ?,
		       WEIGHT = ?
	 	 WHERE NAME = ?
	</entry>
	
	<!-- 물품 삭제용 쿼리문 -->
	<entry key="deleteMouse">
		DELETE 
		  FROM MOUSE
		 WHERE NAME = ?
	</entry>
</properties>
