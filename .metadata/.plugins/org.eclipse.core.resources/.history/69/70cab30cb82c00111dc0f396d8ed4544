<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 
	* 이번에는 mapper 형식의 파일을 작성 (!DOCTYPE mapper)
	
	- SQL 문을 보관하는 파일을 mapper 파일이라고 함!!
	
	* mapper 의 namespace 속성
	
	- 이 mapper 파일의 고유한 별칭을 부여하는 속성 (반드시 작성)
	- 반드시 namespace 속성을 적어두고 나서 mapper 파일의 경로를 등록해야함 (mybatis-config.xml)
-->
 
<mapper namespace="mmeberMapper">
	
	<!-- 
		* mapper 파일에 SQL 문 담아두시
		
		- DML (INSERT, UPDATE, DELETE) 문의 경우
		<insert id="각SQL문들의고유한키값"
				parameterType="전달받을자바타입(풀클래스명) 혹은 별칭">
			쿼리문
		</insert>
		
		<update>쿼리문</update>
		
		<delete>쿼리문</delete>
		
		> parameterType 속성은 전달받을 값이 없다면 (즉, 쿼리문이 완성된 형태라면) 생략 가능하다.
		> update, delete 태그도 마찬가지
		
		- SELECT 문의 경우
		
		* 마이바티스의 mapper 파일 내에서 미완성된 쿼리문 완성시키기
		
		- 만약 미완성된 쿼리문을 완성시킬 데이터로 VO 객체가 넘어왔다면 # {필드명}, 으로 구명을 채울 수 있다.
		- 만약 미완성된 쿼리문을 완성시킬 데이터로 일반 변수값 하나가 넘어왔다면 #{변수명} 으로 구멍을 채우면 된다.
		- 만약 미완성된 쿼리문을 완성시킬 데이터로 HashMap 객체가 넘어온다면 #{키값}
		
		> #{} 는 PreparedStatement 임!!
		  만약, 문자열 타입의 데이터가 들어온다고 한다면 알아서 양쪽에 '' (홑따옴표) 를 붙여서 구멍을 메꿔준다!!
		> ${} 로도 구멍을 채울 수 있긴 함
		  ${} 는 Statement 임!!
		  만약, 문자열타입의 데이터가 들어오면 '' 없이 구멍을 매꿔준다!!
	-->
	
	<!-- 회원 추가용 쿼리문 -->
	<insert id="insertMember" parameterType="com.kh.member.model.vo.Member">
		INSERT INTO MEMBER VALUES(SEQ_USERNO.NEXTVAL
								, #{userId}
								, #{userPwd}
								, #{userName}
								, #{gender}
								, #{age]
								, #{email]
								, #{phone}
								, #{address}
								, DEFAULT)
	</insert>
</mapper>