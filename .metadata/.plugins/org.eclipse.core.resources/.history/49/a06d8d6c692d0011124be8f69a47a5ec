package com.kh.member.model.service;

import java.util.ArrayList;

import org.apache.ibatis.session.SqlSession;

import com.kh.member.common.Template;
import com.kh.member.model.dao.MemberDao;
import com.kh.member.model.vo.Member;
/*
 * * 기존 JDBC 흐음
 * 1) Connection 객체 생성
 * 2) Connection 객체와 전달값을 DAO 로 넘기면서 메소드 호출 후 결과 받기
 * 3) DML 문의 경우 트랜잭션 처리
 * 4) Connection 객체 반납
 * 5) Controller 로 결과 리턴
 * 
 * * 마이바티스 흐름
 * 1) SqlSession 객체 생성 (기존의 Connection + PreparedStatement 역할)
 * 2) SqlSession 객체와 전달값을 넘기면서 DAO 로 요청 후 결과 받기
 * 3) DML 문의 경우 트랜잭션 처리
 * 4) SqlSession 객체 반납
 * 5) Controller 로 결과 리턴
 */
public class MemberService { // 클래스 영역 시작

	/**
	 * 회원 추가용 서비스
	 * @param m => 추가할 회원의 정보
	 * @return => 처리된 행의 갯수
	 */
	public int insertMember(Member m) {
		
		// 1) SqlSession 객체 생성
		SqlSession sqlSession = Template.getSqlSession();
		
		// 2) SqlSession 객체와 전달값을 넘기면서 DAO 로 요청 후 결과 받기
		int result = new MemberDao().insertMember(sqlSession, m);
		
		// 3) DML 문의 경우 트랜잭션 처리
		if(result > 0) {
			// > 성공 (커밋)
		
			sqlSession.commit();
		
		} else {
			// > 실패 (롤백)
			
			sqlSession.rollback();
		}
		
		// 4) SqlSession 객체 반납
		sqlSession.close();
		
		// 5) Controller 로 결과 리턴
		return result;
		
	} // insertMember 끝

	/**
	 * 회원 전체 조회용 서비스
	 * @return => 조회된 회원들의 목록
	 */
	public ArrayList<Member> selectAll() {
		
		// 1) SqlSession 객체 생성
		SqlSession sqlSession = Template.getSqlSession();
		
		// 2) SqlSession 객체와 전달값을 넘기면서 DAO 로 요청 후 결과 받기
		ArrayList<Member> list = new MemberDao().selectAll(sqlSession);
		
		// 3) DML 문의 경우 트랜잭션 처리
		// > select 문 이므로 패스
		
		// 4) SqlSession 객체 반납 
		sqlSession.close();
		
		// 5) Controller 로 결과 리턴
		return list;
		
	} // selectAll 끝

	/**
	 * 회원 아이디 검색용 서비스
	 * @param userId => 검색할 회원의 아이디 (검색어)
	 * @return => 검색된 한명의 회원의 정보
	 */
	public Member selectByUserId(String userId) {
		
		// 1) SqlSession 객체 생성
		SqlSession sqlSession = Template.getSqlSession();
		
		// 2) SqlSession 과 전달값을 DAO 로 넘기면서 요청 후 결과 받기
		Member m = new MemberDao().selectByUserId(sqlSession, userId);
		
		// 3) DML 문의 경우 트랜잭션 처리
		// > select 문이므로 패스
		
		// 4) SqlSession 객체 반납
		sqlSession.close();
		
		// 5) Controller 로 결과 리턴
		return m;
		
	} // selectByUserId 끝

	/**
	 * 회원 이름의 키워드 검색용 서비스
	 * @param keyword => 검색할 회원 이름의 키워드 (검색어)
	 * @return => 검색된 한명의 회원의 회원의 정보
	 */
	public ArrayList<Member> selectByUserName(String keyword) {

		// 1) SqlSession 객체 생성
		SqlSession sqlSession = Template.getSqlSession();
		
		// 2) SqlSession 과 전달값을 DAO 로 넘기면서 요청 후 결과 받기
		ArrayList<Member> list = new MemberDao().selectByUserName(sqlSession, keyword);
		
		// 3) DML 문의 경우 트랜잭션 처리
		//
		
		// 4)
		sqlSession.close();
		
		// 5) Controller 로 결과 리턴
		return list;
	} // selectByUserName
	
	/**
	 * 회원 정보 수정용 서비스
	 * @param m => 변경힐 정보들이 전반적으로 담겨있음
	 * @return => update 된 행의 갯수
	 */
	public int updateMember(Member m) {
		
		// 1) SqlSession 객체 생성
		SqlSession sqlSession = Template.getSqlSession();
		
		// 2) SqlSession 객체와 전달값을 넘기면서 DAO
		int result = new MemberDao().updateMember(sqlSession, m);
		
		// 3) DML 문의 경우 트랜잭션 처리
		if(result > 0) {
			// > 커밋
			
			sqlSession.commit();
			
		} else {
			// > 롤백
			
			sqlSession.rollback();
		}
		
		// 4) SqlSession 객체 반납
		sqlSession.close();
		
		// 5) Controller 로 결과 반환
		return result;
	} // updateMember 끝

	/**
	 * 회원 탈퇴용 서비스
	 * @param userId => 탈퇴시킬 회원의 아이디
	 * @return => delete 된 행의 갯수
	 */
	public int deleteMember(String userId) {
		
		// 1) SqlSession 객체 생성
		SqlSession sqlSession = Template.getSqlSession();
		
		// 2) SqlSession 객체와 전달값을 넘기면서 DAO 호출 후 결과 받기
		int result = new MemberDao().deleteMember(sqlSession, userId);
		
		return 0;
	} // deleteMember 끝
	
} // 클래스 영역 끝
