<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 
	* 이번에는 mapper 형식의 파일을 작성 (!DOCTYPE mapper)
	
	- SQL 문을 보관하는 파일을 mapper 파일이라고 함!!
	
	* mapper 의 namespace 속성
	
	- 이 mapper 파일의 고유한 별칭을 부여하는 속성 (반드시 작성)
	- 반드시 namespace 속성을 적어두고 나서 mapper 파일의 경로를 등록해야함 (mybatis-config.xml)
-->
 
<mapper namespace="mmeberMapper">
	
	<!-- 
		* mapper 파일에 SQL 문 담아두시
		
		- DML (INSERT, UPDATE, DELETE) 문의 경우
		<insert id="각SQL문들의고유한키값"
				parameterType="전달받을자바타입(풀클래스명) 혹은 별칭">
			쿼리문
		</insert>
		
		<update>쿼리문</update>
		
		<delete>쿼리문</delete>
		
		> parameterType 속성은 전달받을 값이 없다면 (즉, 쿼리문이 완성된 형태라면) 생략 가능하다.
		> update, delete 태그도 마찬가지
		
		- SELECT 문의 경우
	-->
	
</mapper>