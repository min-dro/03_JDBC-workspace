package com.kh.member.model.service;

import java.sql.Connection;
import java.util.ArrayList;

import com.kh.member.common.JDBCTemplate;
import com.kh.member.model.dao.MemberDao;
import com.kh.member.model.vo.Member;

/*
 * * Service 단
 * 
 * - JDBC 과정에서 필요한 Connection 객체와 관련된 모든 구문들을 작성하는 부분
 *   (Connection 객체 생성 구문, Connection 객체를 통해 트랜잭션 처리 해주는 구문, Connection 객체 반납 구문)
 * - 즉, 하나의 트랜잭션 단위를 나타내는 부분이라고 보면 된다!!
 * 
 * 참고)
 * 옛날에는 Controller 에서 모든 코드를 다 썼었음!!
 * Controller 에서 코드를 다 짜기에는 너무 길어서 DAO 로 입출력과정 코드만 옮겨둠 (쪼개둠)
 * 그것마저도 DAO 가 너무 기니까 Service 로 트랜잭션 단위의 코드만 또 옮겨둔것!!
 * => low controller fat service
 * 
 * - DAO 단 메소드 한개 == SQL 문 한개를 실행하는 단위
 * - Serviece 단 메소드 한개 == 트랜잭션 한개를 처리하는 단위
 * 
 * * Service 코드 흐름
 * 1) Connection 객체 생성
 * 2) Connection 객체와 Controller 로 부터 전달받은 전달값을 DAO 로 넘기면서 메소드 호출 후 결과 받기
 * 3) INSERT, UPDATEm DELETE 문의 경우 트랜잭션 처리 하기
 * 4) Connection 객체 반납
 * 5) Connection 로 결과 반환
 * 
 * * 최종 MVC 패턴 흐름
 * Run --> View --> Controller --> Service --> DAO <--> DB
 * 			    <--			   <--		   <--
 */
public class MemberService { // 클래스 영역 시작

	/**
	 * 회원 추가 기능 (트랜잭션) 을 담당하는 메소드
	 * @param m => 추가랑 회원의 정보
	 * @return => insert 된 행의 갯수
	 */
	public int insertMember(Member m) {
		
		// 1) Connection 객체 생성
		Connection conn = JDBCTemplate.getConnection();
		
		// 2) Connection 객체와 전달값을 DAO 로 넘기면서 메소드 호출 후 결과 받기
		int result = new MemberDao().insertMember(conn, m);
		
		// 3) INSERT, UPDATE, DELETE일 경우에는 트랜잭션 처리
		if(result > 0) {
			// > 성공 (commit)
			
			JDBCTemplate.commit(conn);
		
		} else {
			// > 실패 (rollback)
			
			JDBCTemplate.rollback(conn);
		}
		
		// 4) Connection 객체 반납
		JDBCTemplate.close(conn);
		
		// 5) Controller 로 결과 리턴
		return result;
		
	} // insertMember 끝
	
	/**
	 * 회원 전체 조회 기능 (트랜잭션) 을 담당하는 메소드
	 * @return => 전체 조회든 회원들의 목록
	 */
	public ArrayList<Member> selectAll() {
		
		// 1) Connection 객체 생성
		Connection conn = JDBCTemplate.getConnection();
		
		// 2) Connection 객체와 전달값을 DAO 로 넘기면서 메소드 호출 후 결과 받기
		ArrayList<Member> list = new MemberDao().selectAll(conn);
		
		// 3) SELECT 문이므로 트랜잭션 처리 패스
		
		// 4) Connection 객체 반납
		JDBCTemplate.close(conn);
		
		// 5) Controller 로 결과 리턴
		return list;
		
	} // selectAll 끝
	
} // 클래스 영역 끝