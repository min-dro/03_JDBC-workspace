package com.kh.member.common;

/*
 * * JDBCTemplate 클래스
 * 
 *  - JDBC 과정 중 반복적으로 쓰이는 구문들을 각각의 메소드 단위로 정의해둘 곳
 *  - 해당 과정이 필요할 때 마다 알맞은 메소드를 계속 호출해서 사용할 것!!
 *  - 자주 쓰이는 코드들을 "재사용할 목적" 으로 공통 탬플릿 (공통 코드) 작업을 진행해보자
 *  
 * => "재사용", "공유" 의 개념이 강한 공통 코드를 작성
 *    이 클래스에서의 모든 메소드들을 죄다 static 메소드로 작성해보자!!
 *    (싱글톤 패턴 적용)
 *    
 * static : 프로그램 시작 시 메모리의 Static 영역에 한번에 올라가고, 프로그램이 종료되기 전까지 언제든지 꺼내 쓸 수 있음
 * 싱글톤 패턴 : 메모리 영역에 단 한번 올라간 것을 계속 가져다 쓰는 (재사용하는) 개념
 * 
 * * JDBC 과정에서 공통적으로 필요한 코드들
 * 1) Connection 객체를 생성하고 트랜잭션 설정을 하는 코드 (자동 커밋 해제)
 * 2) JDBC 용 자원 (객체) 을 반납하는 코드
 * 3) Connection 객체를 가지고 트랜잭션 처리를 해주는 코드
 */
public class JDBCTemplate { // 클래스 영역 시작

	// 1) Connection 객체를 생성하고 트랜잭션 설정 후 그 Connection 객체를 반환해주는 메소드
	public static Connection getConnection() {
		// Connection 객체를 담을 변수 선언
		Connection conn = null;
		
		try {
			
			// Connection 객체를 생성하려면 JDBC Driver 등록부터 해줘야 한다!!
			Class.forName("oracle.jdbc.driver.OracleDriver");
			
			// 2. Connection 객체 생성 (DB 연결)
			conn = DriverManager.getConnection("jdbc:oracle:thin:@localhost:1521:xe", "JDBC", "JDBC");
			
			// 3. 트랜잭션 처리를 위한 자동 커밋 해제
			conn.setAutoCommit(false);
			
		} catch (ClassNotFoundException e) {
			e.printStackTrace();
		} catch (SQLException e) {
			e.printStackTrace();
		}
		
		return conn; // Connection 객체 반환
	} // getConnection() 끝
	
	
} // 클래스 영역 끝